#!/usr/bin/env bash

set -e

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
JEKYLL_RUBYOPT="-r${ROOT_DIR}/_plugins/ruby_4_compat.rb -rliquid -r${ROOT_DIR}/_plugins/bibtex_publications.rb"

RUBYOPT="${JEKYLL_RUBYOPT}${RUBYOPT:+ ${RUBYOPT}}" \
  bundle exec jekyll serve --watch --host 127.0.0.1 --port 4444

#!/usr/bin/env bash

set -e

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

bundle exec ruby "${ROOT_DIR}/bin/generate_publications"

JEKYLL_RUBYOPT="-r${ROOT_DIR}/_plugins/ruby_4_compat.rb"

RUBYOPT="${JEKYLL_RUBYOPT}${RUBYOPT:+ ${RUBYOPT}}" \
  bundle exec jekyll serve --watch --host 127.0.0.1 --port 4444

#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../_plugins/bibtex_publications"

root = File.expand_path("..", __dir__)
bibliography = File.join(root, "_bibliography", "papers.bib")
canonical_bibliography = File.join(root, "_bibliography", "nazarov_references.bib")
output = File.join(root, "_includes", "publications.html")
html = BibtexPublications::Renderer.new.render(
  bibliography,
  canonical_path: canonical_bibliography
)

File.write(output, "#{html.rstrip}\n")
puts "Generated #{output} from #{bibliography}"

require "yaml"
recent_output = File.join(root, "_data", "recent_papers.yml")
recent = BibtexPublications::RecentRenderer.new.items(bibliography, limit: 6)
File.write(
  recent_output,
  "# Generated by bin/generate_publications from _bibliography/papers.bib; do not edit by hand.\n" \
  "# Non-paper items for the Recent list on the home page go in _data/news.yml.\n" +
  recent.to_yaml.sub(/\A---\n/, "")
)
puts "Generated #{recent_output} (#{recent.size} items)"
